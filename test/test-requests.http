### 1. Centralized Error Handling (404 & 500)
################################################

### Test 1.1: 404 Not Found (Invalid Endpoint)
# Expected Response: 404 JSON error
GET {{host}}/non-existent-route

### Test 1.2: 404 Not Found (Non-existent Cat ID)
# Expected Response: 404 JSON error "Kissaa ei löytynyt"
GET {{host}}/cats/999999



################################################
### 2. User Input Validation & Sanitization
################################################

### Test 2.1: Invalid User Registration (Empty Body / Short Fields)
# Expected Response: 400 Bad Request with field-specific messages
POST {{host}}/users
Content-Type: application/json

{
  "username": "ab",
  "email": "not-an-email",
  "password": "123"
}

### Test 2.2: Valid User Registration (Ensure unique username & email)
POST http://localhost:3000/api/v1/users
Content-Type: application/json

{
  "name": "Validation Tester",
  "username": "validUser99",
  "email": "testuser99@example.com",
  "password": "securepassword123"
}


################################################
### 3. File Upload & Validation (POST /api/v1/cats)
################################################

### Test 3.1: Missing Image File
# Expected Response: 400 Bad Request "Invalid or missing file"
POST {{host}}/cats
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=CatBoundary

--CatBoundary
Content-Disposition: form-data; name="cat_name"

Garfield
--CatBoundary
Content-Disposition: form-data; name="weight"

5.5
--CatBoundary
Content-Disposition: form-data; name="birthdate"

2020-01-01
--CatBoundary--

### Test 3.2: Invalid Input Fields for Cat Creation
# Expected Response: 400 Bad Request (cat_name short, weight invalid, bad date format)
POST {{host}}/cats
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=CatBoundary

--CatBoundary
Content-Disposition: form-data; name="cat_name"

Hi
--CatBoundary
Content-Disposition: form-data; name="weight"

-5
--CatBoundary
Content-Disposition: form-data; name="birthdate"

not-a-date
--CatBoundary--