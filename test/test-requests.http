# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


## 1. AUTHENTICATION & USER REGISTRATION

### Register new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Mati",
    "username": "mattia",
    "email": "matti@example.coam",
    "password": "salakala"
}

### User login (Extracts token into @name login)
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "username": "matti",
    "password": "salakala"
}

### Get my user info (Protected)
GET {{apiUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### Get my user info (FAIL: No Token)
GET {{apiUrl}}/auth/me

### Get my user info (FAIL: Invalid Token)
GET {{apiUrl}}/auth/me
Authorization: Bearer invalidtoken123


## ==========================================
## 2. CAT ENDPOINTS
## ==========================================

### Get all cats (Protected)
GET {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}

### Get cat by id
GET {{apiUrl}}/cats/1

### Get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/9999

### Get cats by owner user ID
GET {{apiUrl}}/cats/owner/1

### Post cat WITH IMAGE (Protected)
# @name postCat
POST {{apiUrl}}/cats
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{login.response.body.token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Dogi
--MyBoundary
Content-Disposition: form-data; name="weight"

4
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2022-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="dog.jpg"
Content-Type: image/jpeg

< ./dog.jpg
--MyBoundary--

### Edit existing cat (Protected - Owner/Admin)
PUT {{apiUrl}}/cats/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "weight": 6,
    "cat_name": "Uusi nimi"
}

### Delete cat by id (Protected - Owner/Admin)
DELETE {{apiUrl}}/cats/1
Authorization: Bearer {{login.response.body.token}}


### Edit your own cat
PUT {{apiUrl}}/cats/5
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "weight": 6,
    "cat_name": "Uusi nimi"
}

### Delete your own cat
DELETE {{apiUrl}}/cats/5
Authorization: Bearer {{login.response.body.token}}